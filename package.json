{
  "name": "homebridge-mykoplus",
  "version": "1.0.0",
  "description": "Homebridge plugin for Myko+ smart home devices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:auth": "ts-node scripts/test-auth.ts"
  },
  "keywords": [
    "homebridge-plugin",
    "myko",
    "mykoplus",
    "kingfisher",
    "homekit"
  ],
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.6.0"
  },
  "author": "Nitatemic",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitatemic/homebridge-mykoplus.git"
  },
  "bugs": {
    "url": "https://github.com/nitatemic/homebridge-mykoplus/issues"
  },
  "homepage": "https://github.com/nitatemic/homebridge-mykoplus#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "homebridge": "^1.8.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "watchman": false
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
